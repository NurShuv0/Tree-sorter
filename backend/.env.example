# Tree Sorter Django Backend – Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file.

# ── Django Core ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-long-secure-random-secret-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Frontend URL (used in password-reset links) ───────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Database (MySQL 8.0+) ─────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.mysql
DB_NAME=tree_sorter
DB_USER=tree_sorter_user
DB_PASSWORD=replace-with-a-secure-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# ── Email (console backend for local dev) ────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@treesorter.local

# ── JWT Token Lifetimes ───────────────────────────────────────────────────────
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
