{
  "compilerOptions": {
    /* ── Language & Output ─────────────────────────────────────────────────── */
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* ── Module Resolution ──────────────────────────────────────────────────── */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* ── React ──────────────────────────────────────────────────────────────── */
    "jsx": "react-jsx",

    /* ── Path Aliases ───────────────────────────────────────────────────────── */
    /* Mirrors the alias defined in vite.config.ts so the TS language server  */
    /* can resolve @/... imports (e.g. @/auth/authTypes, @/api/authApi).       */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* ── Strict Type Checking ───────────────────────────────────────────────── */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
