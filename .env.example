# Tree Sorter Backend Configuration
# Copy this file to a new file named '.env' and fill in your own values.

# Server listening port
PORT=5000

# ── Frontend API URLs (read by Vite/React) ──────────────────────────────────
# Django REST API for authentication
VITE_DJANGO_API_URL=http://localhost:8000/api
# Express AI chat API
VITE_CHAT_API_URL=http://localhost:5000/api

# Choose AI Provider: 'groq' (recommended, free) | 'gemini' | 'ollama'
AI_PROVIDER=groq

# 1. Groq Provider Configuration (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini Provider Configuration (used if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Local Ollama Provider Configuration (used if AI_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# 4. Optional Request Timeout in milliseconds
# (default 15000 for Gemini/Groq, 300000 for local Ollama)
AI_TIMEOUT_MS=300000
